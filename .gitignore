# Anchored to the repo root so it only ignores the Maven/Jenesis build output,
# not Maven-coordinate paths like data/scanned/com/target/ where "target" is a
# legitimate groupId segment.
/target/
*.hprof
# Everything the tool writes: the resolved artifacts, the caches, the compiled
# engine and its stamp. Nothing tracked lives here - the vendored engine is the
# build/.upstream submodule - so the whole folder is safe to delete.
.jenesis/

### IntelliJ IDEA ###
.idea/*
*.iws
*.iml
*.ipr

